diff --git a/gcc/config/mips/mips.c b/gcc/config/mips/mips.c
--- a/gcc/config/mips/mips.c
+++ b/gcc/config/mips/mips.c
@@ -145,8 +145,47 @@
   struct extern_list *next;	/* next external */
   char *name;			/* name of the external */
   int size;			/* size in bytes */
+  int r5900_bare_int_ref;	/* ASTRA P34: marked during final output */
 } *extern_head = 0;
 
+/* ASTRA P34: opt-in R5900/GAS extern buffering.  The retail assembler needs
+   the size of a small-data-eligible external before the reference; GAS is
+   single-pass, so the compiler output is buffered and the selected .extern
+   declarations are emitted in front of it.  */
+char *mips_astra_r5900_extern_buffer;
+static FILE *r5900_real_asm_file;
+static FILE *r5900_body_asm_file;
+#define TARGET_R5900_GAS_EXTERN_BUFFER \
+  (TARGET_MIPS5900 && TARGET_GAS && TARGET_GP_OPT \
+   && mips_astra_r5900_extern_buffer)
+
+/* ASTRA P34: mark a bare integer memory reference to a GP-eligible symbol so
+   its .extern is emitted before the buffered body.  */
+static void
+mips_r5900_mark_bare_int_ref (addr)
+     rtx addr;
+{
+  struct extern_list *p;
+  rtx sym;
+
+  if (! TARGET_R5900_GAS_EXTERN_BUFFER)
+    return;
+
+  sym = 0;
+  if (GET_CODE (addr) == SYMBOL_REF)
+    sym = addr;
+
+  if (sym == 0 || ! SYMBOL_REF_FLAG (sym))
+    return;
+
+  for (p = extern_head; p != 0; p = p->next)
+    if (strcmp (p->name, XSTR (sym, 0)) == 0)
+      {
+	p->r5900_bare_int_ref = 1;
+	return;
+      }
+}
+
 /* Name of the file containing the current function.  */
 char *current_function_file = "";
 
@@ -5125,7 +5164,13 @@
     }
 
   else if (code == MEM)
-    output_address (XEXP (op, 0));
+    {
+      if (TARGET_R5900_GAS_EXTERN_BUFFER
+	  && GET_MODE_CLASS (GET_MODE (op)) == MODE_INT)
+	mips_r5900_mark_bare_int_ref (XEXP (op, 0));
+
+      output_address (XEXP (op, 0));
+    }
 
   else if (code == CONST_DOUBLE
 	   && GET_MODE_CLASS (GET_MODE (op)) == MODE_FLOAT)
@@ -5316,6 +5361,7 @@
       p->next = extern_head;
       p->name = name;
       p->size = len;
+      p->r5900_bare_int_ref = 0;
       extern_head = p;
     }
 
@@ -5332,6 +5378,8 @@
       p->next = extern_head;
       p->name = name;
       p->size = -1;
+  p->r5900_bare_int_ref = 0;
+      p->r5900_bare_int_ref = 0;
       extern_head = p;
     }
 #endif
@@ -5597,7 +5645,19 @@
     fprintf (stream, "\n%s -G value = %d, Cpu = %s, ISA = %d\n",
 	     ASM_COMMENT_START,
 	     mips_section_threshold, mips_cpu_string, mips_isa);
-}
+
+  if (TARGET_R5900_GAS_EXTERN_BUFFER)
+    {
+      r5900_real_asm_file = stream;
+      r5900_body_asm_file = tmpfile ();
+
+      if (r5900_body_asm_file == 0)
+	pfatal_with_name ("R5900 assembly temporary file");
+
+      asm_out_file = r5900_body_asm_file;
+      asm_out_data_file = r5900_body_asm_file;
+      asm_out_text_file = r5900_body_asm_file;
+    }}
 
 /* If we are optimizing the global pointer, emit the text section now and any
    small externs which did not have .comm, etc that are needed.  Also, give a
@@ -5612,38 +5672,70 @@
   tree name_tree;
   struct extern_list *p;
   int len;
+  FILE *out;
+
+  out = (TARGET_R5900_GAS_EXTERN_BUFFER && r5900_real_asm_file != 0)
+	? r5900_real_asm_file : file;
 
   if (HALF_PIC_P ())
     {
-      HALF_PIC_FINISH (file);
+      HALF_PIC_FINISH (out);
     }
 
   if (extern_head)
     {
-      fputs ("\n", file);
+      fputs ("\n", out);
 
       for (p = extern_head; p != 0; p = p->next)
 	{
 	  name_tree = get_identifier (p->name);
 
 	  /* Positively ensure only one .extern for any given symbol.  */
-	  if (! TREE_ASM_WRITTEN (name_tree))
+	  if (! TREE_ASM_WRITTEN (name_tree)
+	      && (! TARGET_R5900_GAS_EXTERN_BUFFER
+		  || p->r5900_bare_int_ref))
 	    {
 	      TREE_ASM_WRITTEN (name_tree) = 1;
 #ifdef ASM_OUTPUT_UNDEF_FUNCTION
 	      if (p->size == -1)
-		ASM_OUTPUT_UNDEF_FUNCTION (file, p->name);
+		ASM_OUTPUT_UNDEF_FUNCTION (out, p->name);
 	      else
 #endif
 		{
-		  fputs ("\t.extern\t", file);
-		  assemble_name (file, p->name);
-		  fprintf (file, ", %d\n", p->size);
+		  fputs ("\t.extern\t", out);
+		  assemble_name (out, p->name);
+		  fprintf (out, ", %d\n", p->size);
 		}
 	    }
 	}
     }
       
+  if (TARGET_R5900_GAS_EXTERN_BUFFER)
+    {
+      char copybuf[8192];
+      int clen;
+      FILE *body = r5900_body_asm_file;
+
+      asm_out_file = out;
+
+      if (body != 0)
+	{
+	  rewind (body);
+	  while ((clen = fread (copybuf, 1, sizeof (copybuf), body)) > 0)
+	    if ((int) fwrite (copybuf, 1, clen, out) != clen)
+	      pfatal_with_name (asm_file_name);
+
+	  r5900_body_asm_file = 0;
+	  if (fclose (body) != 0)
+	    fatal ("cannot close R5900 assembly buffer");
+	}
+
+      r5900_real_asm_file = 0;
+      asm_out_data_file = out;
+      asm_out_text_file = out;
+      return;
+    }
+
   if (TARGET_FILE_SWITCHING && ! TARGET_MIPS16)
     {
       fprintf (file, "\n\t.text\n");
diff --git a/gcc/config/mips/mips.h b/gcc/config/mips/mips.h
