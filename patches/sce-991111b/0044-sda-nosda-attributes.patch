diff --git a/gcc/tree.h b/gcc/tree.h
index f914cdd..e0a6528 100644
--- a/gcc/tree.h
+++ b/gcc/tree.h
@@ -1244,6 +1244,10 @@ struct tree_type
 /* Used to indicate that this DECL has weak linkage.  */
 #define DECL_WEAK(NODE) (DECL_CHECK (NODE)->decl.weak_flag)
 
+/* SN port: sda/nosda attributes (small-data placement).  */
+#define DECL_SDA(NODE) (DECL_CHECK (NODE)->decl.sda_flag)
+#define DECL_NOSDA(NODE) (DECL_CHECK (NODE)->decl.no_sda_flag)
+
 /* Used in TREE_PUBLIC decls to indicate that copies of this DECL in
    multiple translation units should be merged.  */
 #define DECL_ONE_ONLY(NODE) (DECL_CHECK (NODE)->decl.transparent_union)
@@ -1311,6 +1315,10 @@ struct tree_decl
   unsigned artificial_flag : 1;
   unsigned weak_flag : 1;
 
+  /* SN port: sda/nosda attributes force (or forbid) small-data placement.  */
+  unsigned sda_flag : 1;
+  unsigned no_sda_flag : 1;
+
   unsigned lang_flag_0 : 1;
   unsigned lang_flag_1 : 1;
   unsigned lang_flag_2 : 1;
