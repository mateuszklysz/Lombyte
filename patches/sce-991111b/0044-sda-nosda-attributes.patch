   add_attribute (A_NO_CHECK_MEMORY_USAGE, "no_check_memory_usage", 0, 0, 1);
+  /* SN port: SDA ATTR MODS */
+  add_attribute (A_SDA, "sda", 0, 0, 1);
+  add_attribute (A_NOSDA, "nosda", 0, 0, 1);
 }
 
 /* Process the attributes listed in ATTRIBUTES and PREFIX_ATTRIBUTES
@@ -869,6 +872,33 @@ decl_attributes (node, attributes, prefix_attributes)
 	  declare_weak (decl);
 	  break;
 
+	/* SN port: SDA ATTR MODS (from SN 2.95.3 source, c-common.c)  */
+	case A_SDA:
+	  if (TREE_CODE (decl) == VAR_DECL)
+	    {
+	      if (DECL_NOSDA (decl))
+		error_with_decl (decl,
+				 "cannot have both sda and nosda attributes for `%s'");
+	      else
+		DECL_SDA (decl) = 1;
+	    }
+	  else
+	    error_with_decl (decl, "sda attribute not allowed for `%s'");
+	  break;
+
+	case A_NOSDA:
+	  if (TREE_CODE (decl) == VAR_DECL)
+	    {
+	      if (DECL_SDA (decl))
+		error_with_decl (decl,
+				 "cannot have both sda and nosda attributes for `%s'");
+	      else
+		DECL_NOSDA (decl) = 1;
+	    }
+	  else
+	    error_with_decl (decl, "nosda attribute not allowed for `%s'");
+	  break;
+
 	case A_ALIAS:
 	  if ((TREE_CODE (decl) == FUNCTION_DECL && DECL_INITIAL (decl))
 	      || (TREE_CODE (decl) != FUNCTION_DECL && ! DECL_EXTERNAL (decl)))
