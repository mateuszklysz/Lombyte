+/* ASTRA P25: opt-in.  The retail compiler annuls a conditional branch
+   when its delay-slot instruction writes the register the branch tests
+   and that register is dead on the not-taken path (the branch-likely
+   form, for example `bnezl v0,L; move v0,zero`).  reorg only annuls when
+   it steals from a branch target; do the same for fall-through-filled
+   slots after scheduling, when the policy is selected.  */
+
+void
+mips_r5900_annul_dead_slots (first)
+     rtx first;
+{
+  rtx insn;
+
+  if (! TARGET_MIPS5900 || ! mips_astra_annul_dead_slots)
+    return;
+
+  for (insn = first; insn; insn = NEXT_INSN (insn))
+    {
+      rtx body, br, trial, set, dest, condition, p;
+      int safe = 0;
+
+      if (GET_CODE (insn) != INSN || GET_CODE (PATTERN (insn)) != SEQUENCE)
+	continue;
+      body = PATTERN (insn);
+      if (XVECLEN (body, 0) != 2)
+	continue;
+      br = XVECEXP (body, 0, 0);
+      if (GET_CODE (br) != JUMP_INSN || ! condjump_p (br)
+	  || INSN_ANNULLED_BRANCH_P (br))
+	continue;
+      trial = XVECEXP (body, 0, 1);
+      if (GET_CODE (trial) != INSN)
+	continue;
+      set = single_set (trial);
+      if (set == 0 || GET_CODE (SET_DEST (set)) != REG
+	  || GET_MODE (SET_DEST (set)) == BLKmode)
+	continue;
+      dest = SET_DEST (set);
+      if (dest == stack_pointer_rtx || dest == hard_frame_pointer_rtx
+	  || dest == frame_pointer_rtx)
+	continue;
+
+      /* Only when the delay-slot register is one the branch tests (the
+	 retail `bnez v0,L; move v0,zero` shape).  */
+      condition = get_condition (br, NULL_RTX);
+      if (condition == 0 || ! reg_mentioned_p (dest, condition))
+	continue;
+
+      /* Walk the not-taken path: the register must be written before it
+	 is read (or be clobbered by a call).  */
+      for (p = NEXT_INSN (insn); p; p = NEXT_INSN (p))
+	{
+	  rtx inner;
+
+	  if (GET_CODE (p) == NOTE)
+	    continue;
+	  if (GET_CODE (p) == CODE_LABEL || GET_CODE (p) == BARRIER)
+	    break;
+	  if (GET_CODE (p) == JUMP_INSN)
+	    break;
+	  if (GET_CODE (p) == CALL_INSN)
+	    {
+	      if (call_used_regs[REGNO (dest)])
+		safe = 1;
+	      break;
+	    }
+	  if (GET_CODE (p) != INSN)
+	    continue;
+	  inner = single_set (p);
+	  if (inner != 0 && GET_CODE (SET_DEST (inner)) == REG
+	      && REGNO (SET_DEST (inner)) == REGNO (dest))
+	    {
+	      safe = 1;
+	      break;
+	    }
+	  if (reg_mentioned_p (dest, PATTERN (p)))
+	    break;
+	}
+      if (safe)
+	INSN_ANNULLED_BRANCH_P (br) = 1;
+    }
+}
