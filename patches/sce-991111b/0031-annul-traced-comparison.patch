diff --git a/gcc/config/mips/mips.c b/gcc/config/mips/mips.c
--- a/gcc/config/mips/mips.c
+++ b/gcc/config/mips/mips.c
@@ -8926,7 +8926,35 @@
 	  || (XEXP (condition, 0) != const0_rtx
 	      && XEXP (condition, 1) != const0_rtx)
 	  || SET_SRC (set) != const0_rtx)
-	continue;
+	{
+	  /* ASTRA P40: get_condition may trace the tested register back to
+	     an arithmetic producer (e.g. slt) and report that comparison.
+	     Fall back to the branch's own comparison; if the branch tests
+	     this register against zero and the delay slot writes zero, the
+	     skipped write is a no-op on the not-taken path (not-taken of
+	     `ne dest,0` implies dest is zero), so the shape is safe.  */
+	  rtx own = 0;
+
+	  if (GET_CODE (PATTERN (br)) == SET
+	      && GET_CODE (SET_SRC (PATTERN (br))) == IF_THEN_ELSE)
+	    own = XEXP (SET_SRC (PATTERN (br)), 0);
+
+	  if (own != 0
+	      && GET_CODE (own) == NE
+	      && reg_mentioned_p (dest, own)
+	      && (XEXP (own, 0) == const0_rtx
+		  || XEXP (own, 1) == const0_rtx
+		  || (GET_CODE (XEXP (own, 0)) == REG
+		      && REGNO (XEXP (own, 0)) == 0)
+		  || (GET_CODE (XEXP (own, 1)) == REG
+		      && REGNO (XEXP (own, 1)) == 0))
+	      && (SET_SRC (set) == const0_rtx
+		  || (GET_CODE (SET_SRC (set)) == REG
+		      && REGNO (SET_SRC (set)) == 0)))
+	    safe = 1;
+	  else
+	    continue;
+	}
 
       /* Walk the not-taken path: the register must be written before it
 	 is read (or be clobbered by a call).  */
