diff --git a/gas/config/tc-mips.c b/gas/config/tc-mips.c
--- a/gas/config/tc-mips.c
+++ b/gas/config/tc-mips.c
@@ -11701,6 +11701,25 @@
       if (new > 0)
 	memcpy (fixptr - old, fixptr, new);
 
+      /* ASTRA P20: the retail R5900 assembler expands a relaxable gp
+	 pair to the absolute form `lui base,0` + `op %lo(base)`.  The
+	 default expansion keeps a copy of the second instruction in the
+	 first slot (md_convert_frag can even be entered twice, which
+	 leaves two copies), so rebuild the first word from the base
+	 register of the second.  Only the 4/8-byte ld_st and la pairs
+	 are touched.  */
+      if (mips_pic == NO_PIC
+	  && old == 4 && new == 8
+	  && RELAX_RELOC2 (fragp->fr_subtype) == 4)
+	{
+	  unsigned char *pair = (unsigned char *) (fragp->fr_literal
+						   + fragp->fr_fix - old);
+	  unsigned long second = bfd_get_32 (stdoutput, pair + 4);
+	  unsigned long base = (second >> 21) & 0x1f;
+
+	  md_number_to_chars ((char *) pair, 0x3c000000UL | (base << 16), 4);
+	}
+
       fragp->fr_fix += new - old;
     }
 }
