--- a/gcc/config/mips/mips.c
+++ b/gcc/config/mips/mips.c
@@ -8966,8 +8966,35 @@
 	    continue;
 	  n++;
 	}
+      else if (code == JUMP_INSN
+	       && (GET_CODE (PATTERN (insn)) == ADDR_VEC
+		   || GET_CODE (PATTERN (insn)) == ADDR_DIFF_VEC))
+	continue;
       else if (code == CALL_INSN || code == JUMP_INSN)
-	n++;
+	{
+	  /* ASTRA P46: a branch or call whose delay slot reorg left empty is
+	     emitted in reorder mode, and GAS appends its delay NOP, so it
+	     occupies two words.  A short loop closed by such a branch is
+	     padded like a filled one (the pads are emitted under noreorder,
+	     so GAS cannot move one into the empty slot).  */
+	  if (code == JUMP_INSN)
+	    {
+	      rtx label = condjump_label (insn);
+	      int start = -1;
+
+	      if (label != 0 && GET_CODE (label) == LABEL_REF)
+		start = label_count[INSN_UID (XEXP (label, 0))];
+
+	      if (start >= 0)
+		{
+		  int loop = n - start + 2;
+
+		  for (; loop < 7; loop++)
+		    emit_insn_before (gen_nop (), insn);
+		}
+	    }
+	  n += 2;
+	}
     }
 }
 
