diff --git a/gcc/config/mips/mips.c b/gcc/config/mips/mips.c
--- a/gcc/config/mips/mips.c
+++ b/gcc/config/mips/mips.c
@@ -209,6 +209,8 @@
 char *mips_cpu_string;		/* for -mcpu=<xxx> */
 char *mips_isa_string;		/* for -mips{1,2,3,4} */
 char *mips_abi_string;		/* for -mabi={32,n32,64,eabi} */
+/* ASTRA P21: opt-in retention of the save_restore_insns emission order.  */
+char *mips_astra_keep_frame_order;
 
 /* Whether we are generating mips16 code.  This is a synonym for
    TARGET_MIPS16, and exists for use as an attribute.  */
diff --git a/gcc/config/mips/mips.h b/gcc/config/mips/mips.h
--- a/gcc/config/mips/mips.h
+++ b/gcc/config/mips/mips.h
@@ -151,6 +151,8 @@
 extern char *mips_no_mips16_string;	/* for -mno-mips16 */
 extern char *mips_explicit_type_size_string;   /* for -mexplicit-type-size */
 extern int mips_split_addresses;	/* perform high/lo_sum support */
+/* ASTRA P21: keep frame-related insns in scheduler program order.  */
+extern char *mips_astra_keep_frame_order;
 extern int dslots_load_total;		/* total # load related delay slots */
 extern int dslots_load_filled;		/* # filled load delay slots */
 extern int dslots_jump_total;		/* total # jump related delay slots */
@@ -610,7 +612,8 @@
   { "max-skip-functions=",	&mips_max_skip_funcs_string },		\
   /* END CYGNUS LOCAL */						\
   { "no-mips16", &mips_no_mips16_string	},                              \
-  { "explicit-type-size", &mips_explicit_type_size_string }		\
+  { "explicit-type-size", &mips_explicit_type_size_string },		\
+  { "astra-keep-frame-order", &mips_astra_keep_frame_order }		\
 }
 
 /* This is meant to be redefined in the host dependent files.  */
diff --git a/gcc/haifa-sched.c b/gcc/haifa-sched.c
--- a/gcc/haifa-sched.c
+++ b/gcc/haifa-sched.c
@@ -4065,7 +4065,18 @@
   rtx link;
   int tmp_class, tmp2_class, depend_count1, depend_count2;
   int val, priority_val, spec_val, prob_val, weight_val;
-
+  extern char *mips_astra_keep_frame_order;
+
+
+  /* ASTRA P21: opt-in retention of the save_restore_insns emission order.
+     The retail compiler emits prologue saves and epilogue restores in the
+     order save_restore_insns produced them; the priority comparison
+     otherwise reorders independent saves (it can sink the $ra save past
+     the callee-saved ones).  Only enabled per unit: other units' retail
+     objects show the scheduler-reordered form.  */
+  if (mips_astra_keep_frame_order
+      && RTX_FRAME_RELATED_P (tmp) && RTX_FRAME_RELATED_P (tmp2))
+    return INSN_LUID (tmp) - INSN_LUID (tmp2);
 
   /* prefer insn with higher priority */
   priority_val = INSN_PRIORITY (tmp2) - INSN_PRIORITY (tmp);
diff --git a/gcc/sched.c b/gcc/sched.c
--- a/gcc/sched.c
+++ b/gcc/sched.c
@@ -1842,6 +1842,12 @@
   rtx link;
   int tmp_class, tmp2_class;
   int value;
+  extern char *mips_astra_keep_frame_order;
+
+  /* ASTRA P21: opt-in retention of the emission order (see haifa-sched.c).  */
+  if (mips_astra_keep_frame_order
+      && RTX_FRAME_RELATED_P (tmp) && RTX_FRAME_RELATED_P (tmp2))
+    return INSN_LUID (tmp) - INSN_LUID (tmp2);
 
   /* Choose the instruction with the highest priority, if different.  */
   if ((value = INSN_PRIORITY (tmp) - INSN_PRIORITY (tmp2)))
