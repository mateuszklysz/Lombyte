     }
 }
 
+/* ASTRA 0038-unannul-redundant: reorg.c's generic delay-slot filler (fill_slots_from_thread,
+   via mark_target_live_regs/next_insn_no_annul) treats a SEQUENCE it walks
+   past as opaque: it looks at the SEQUENCE's branch but never at the
+   SEQUENCE's own delay-slot insn, so it can believe a register is still
+   "needed" past a point where the very next branch's delay slot in fact
+   overwrites it unconditionally (regardless of that branch's own outcome).
+   This makes reorg pick the annulled (branch-likely) form for a delay slot
+   that plainly materializes a constant into a register, when retail keeps
+   the plain form because annulling buys nothing there.
+
+   Undo that specific, narrow case: INSN is annulled, its delay slot sets
+   DEST to a plain constant, and the immediately following insn is itself an
+   already delay-filled branch whose own delay slot unconditionally
+   overwrites DEST with a value that does not depend on DEST's old value,
+   and whose branch condition does not read DEST.  In that shape, whichever
+   value INSN's delay slot leaves in DEST is dead before anything can read
+   it - annulled and plain are behaviorally identical, so match retail and
+   clear the flag.  */
+
+void
+mips_r5900_unannul_redundant (first)
+     rtx first;
+{
+  rtx insn;
+
+  if (! TARGET_MIPS5900 || ! mips_astra_unannul_redundant)
+    return;
+
+  for (insn = first; insn; insn = NEXT_INSN (insn))
+    {
+      rtx body, br, trial, set, dest, next, seq, sbr, strial, sset;
+
+      if (GET_CODE (insn) != INSN || GET_CODE (PATTERN (insn)) != SEQUENCE)
+	continue;
+      body = PATTERN (insn);
+      if (XVECLEN (body, 0) != 2)
+	continue;
+      br = XVECEXP (body, 0, 0);
+      if (GET_CODE (br) != JUMP_INSN || ! INSN_ANNULLED_BRANCH_P (br))
+	continue;
+      trial = XVECEXP (body, 0, 1);
+      if (GET_CODE (trial) != INSN)
+	continue;
+      set = single_set (trial);
+      if (set == 0 || GET_CODE (SET_DEST (set)) != REG
+	  || GET_CODE (SET_SRC (set)) != CONST_INT)
+	continue;
+      dest = SET_DEST (set);
+      if (dest == stack_pointer_rtx || dest == hard_frame_pointer_rtx
+	  || dest == frame_pointer_rtx)
+	continue;
+
+      next = NEXT_INSN (insn);
+      while (next && GET_CODE (next) == NOTE)
+	next = NEXT_INSN (next);
+      if (next == 0 || GET_CODE (next) != INSN
+	  || GET_CODE (PATTERN (next)) != SEQUENCE)
+	continue;
+      seq = PATTERN (next);
+      if (XVECLEN (seq, 0) != 2)
+	continue;
+      sbr = XVECEXP (seq, 0, 0);
+      if (GET_CODE (sbr) != JUMP_INSN
+	  || reg_mentioned_p (dest, PATTERN (sbr)))
+	continue;
+      strial = XVECEXP (seq, 0, 1);
+      if (GET_CODE (strial) != INSN)
+	continue;
+      sset = single_set (strial);
+      if (sset == 0 || GET_CODE (SET_DEST (sset)) != REG
+	  || REGNO (SET_DEST (sset)) != REGNO (dest)
+	  || reg_mentioned_p (dest, SET_SRC (sset)))
+	continue;
+
+      INSN_ANNULLED_BRANCH_P (br) = 0;
+    }
+}
