+
+/* ASTRA P19: the retail R5900 assembler lengthens every loop shorter than
+   seven instructions (counted from the loop label through the branch and
+   its delay slot) with NOPs placed immediately before the branch.  The pass
+   above runs before delay slot scheduling and discards its loop history at
+   calls, so the retail assembler supplied the padding for those loops.
+   Reproduce the assembler's rule here, after the delay slots are filled.  */
+
+void
+mips_r5900_pad_loops (first)
+     rtx first;
+{
+  rtx insn;
+  int i, n = 0;
+  int max_uid = get_max_uid ();
+  int *label_count = (int *) alloca (sizeof (int) * (max_uid + 1));
+
+  if (! TARGET_MIPS5900)
+    return;
+
+  for (i = 0; i <= max_uid; i++)
+    label_count[i] = -1;
+
+  for (insn = first; insn; insn = NEXT_INSN (insn))
+    {
+      enum rtx_code code = GET_CODE (insn);
+
+      if (code == CODE_LABEL)
+	{
+	  label_count[INSN_UID (insn)] = n;
+	  continue;
+	}
+
+      if (code == INSN && GET_CODE (PATTERN (insn)) == SEQUENCE)
+	{
+	  rtx branch = XVECEXP (PATTERN (insn), 0, 0);
+	  int length = XVECLEN (PATTERN (insn), 0);
+
+	  if (GET_CODE (branch) == JUMP_INSN)
+	    {
+	      rtx label = condjump_label (branch);
+	      int start = -1;
+
+	      if (label != 0 && GET_CODE (label) == LABEL_REF)
+		start = label_count[INSN_UID (XEXP (label, 0))];
+
+	      if (start >= 0)
+		{
+		  int loop = n - start + length;
+
+		  for (; loop < 7; loop++)
+		    emit_insn_before (gen_nop (), insn);
+		}
+	    }
+
+	  n += length;
+	  continue;
+	}
+
+      if (code == INSN)
+	{
+	  enum rtx_code pat = GET_CODE (PATTERN (insn));
+
+	  if (pat == USE || pat == CLOBBER)
+	    continue;
+	  n++;
+	}
+      else if (code == CALL_INSN || code == JUMP_INSN)
+	n++;
+    }
+}
 
