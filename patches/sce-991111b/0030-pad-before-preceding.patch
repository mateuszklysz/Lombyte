diff --git a/gcc/config/mips/mips.c b/gcc/config/mips/mips.c
--- a/gcc/config/mips/mips.c
+++ b/gcc/config/mips/mips.c
@@ -8757,10 +8757,37 @@
 		  int distance 
 		    = n - seen_before [INSN_UID (XEXP (target, 0))];
 
-		  for (; distance <= 6; distance++)
-		    {
-		      emit_insn_before (gen_nop (), insn);
-		    }
+		  {
+		    /* ASTRA P38: the retail loop length counts the branch
+		       itself, and a single pad is placed before the preceding
+		       real instruction so the dbr backward scan sees that
+		       instruction first (a useful instruction can fill the
+		       slot; the NOP remains a fallback and stays in front of
+		       the branch).  When the preceding instruction cannot be a
+		       slot candidate (call/jump/sequence/absent), keep the
+		       historical count and placement.  */
+		    int stealable = 0;
+		    rtx prev = prev_nonnote_insn (insn);
+		    int pads = 0;
+		    int d;
+		    rtx anchor = insn;
+
+		    if (prev != 0
+			&& GET_CODE (prev) == INSN
+			&& GET_CODE (PATTERN (prev)) != USE
+			&& GET_CODE (PATTERN (prev)) != CLOBBER
+			&& GET_CODE (PATTERN (prev)) != SEQUENCE)
+		      stealable = 1;
+
+		    for (d = stealable ? distance + 1 : distance; d <= 6; d++)
+		      pads++;
+
+		    if (stealable && pads == 1)
+		      anchor = prev;
+
+		    while (pads-- > 0)
+		      emit_insn_before (gen_nop (), anchor);
+		  }
 		}
 	    }
 
