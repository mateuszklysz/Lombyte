diff --git a/gcc/haifa-sched.c b/gcc/haifa-sched.c
--- a/gcc/haifa-sched.c
+++ b/gcc/haifa-sched.c
@@ -4135,6 +4135,18 @@
 	return val;
     }
 
+  /* Prefer frame-related stores (prologue saves): retail schedules the
+     saved registers ahead of the body instructions that reuse them.  */
+  {
+    rtx p1 = PATTERN (tmp), p2 = PATTERN (tmp2);
+    int f1 = (RTX_FRAME_RELATED_P (tmp)
+	      && GET_CODE (p1) == SET && GET_CODE (SET_DEST (p1)) == MEM);
+    int f2 = (RTX_FRAME_RELATED_P (tmp2)
+	      && GET_CODE (p2) == SET && GET_CODE (SET_DEST (p2)) == MEM);
+    if (f2 != f1)
+      return f2 - f1;
+  }
+
   /* Prefer the insn which has more later insns that depend on it. 
      This gives the scheduler more freedom when scheduling later
      instructions at the expense of added register pressure.  */
